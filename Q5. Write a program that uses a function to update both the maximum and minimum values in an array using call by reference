#include <stdio.h>

void findMaxMin(int arr[], int n, int *max, int *min) {
    int i;
    *max = *min = arr[0];
    for(i = 1; i < n; i++) {
        if(arr[i] > *max) *max = arr[i];
        if(arr[i] < *min) *min = arr[i];
    }
}

int main() {
    int arr[5] = {12, 5, 89, 3, 45};
    int max, min;
    findMaxMin(arr, 5, &max, &min);
    printf("Maximum = %d\n", max);
    printf("Minimum = %d", min);
    return 0;
}
